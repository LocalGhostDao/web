# ghost.maild , the mail relay (deploy/mail/README.md), as a systemd USER unit of the deploy
# user: install.sh writes it to ~/.config/systemd/user/ with @ROOT@ filled in. Lingering keeps
# it running without a login and after a reboot (root-once.sh).
[Unit]
Description=LocalGhost mail relay
After=network-online.target

[Service]
ExecStart=@ROOT@/bin/ghost.maild -conf @ROOT@/etc/maild.conf
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
LimitNOFILE=4096

[Install]
WantedBy=default.target
