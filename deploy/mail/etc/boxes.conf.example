# ~/ghost-mail/etc/boxes.conf , one line per box. Each line comes from the box itself:
#   ghost-cli ghost.noted mail-enrol        (or SETTINGS › MAIL › THE RELAY'S LINE on the phone)
# box=       the box id (lower case, digits, dashes), the same the box has in SETTINGS › MAIL
# addresses= single addresses on a shared domain of the relay's (vlad@ghost.localghost.ai), comma separated
# domains=   domain(s) the box owns whole, comma separated; their MX must point at this relay
#            (a line has addresses=, domains=, or both)
# pub=       the box's X25519 mail public key (64 hex), what every message is sealed to
# token=     the sha256 of the box's bearer token (64 hex); the token itself never leaves the box
# dkim_rsa=  the box's RSA DKIM public key (base64 DER), published by `ghost-maild -dns <shared domain>`
# dkim_ed=   the box's Ed25519 DKIM public key (base64), likewise
# sendday=   (optional) this box's own daily sending allowance
#
# box=vlad addresses=vlad@ghost.localghost.ai pub=<64 hex> token=<64 hex> dkim_rsa=<base64> dkim_ed=<base64>
# box=ana  domains=ghost.ana.example      pub=<64 hex> token=<64 hex> dkim_rsa=<base64> dkim_ed=<base64>
