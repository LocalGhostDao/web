#!/usr/sbin/nft -f
# The relay's nftables table, kept by scripts/firewall.sh: what port 25 accepts before the relay
# sees a byte. A table of its own (inet ghostmail), so the machine's other rules are not touched;
# the first two lines make it idempotent to load again. The machine's own policy decides whether
# 25 is open at all; this table only limits.
table inet ghostmail {}
flush table inet ghostmail

table inet ghostmail {
	# new connections per source address: more than 10 a minute (burst 20) is a scanner or a
	# flood, not a mail server, which retries in minutes
	set smtp_meter {
		type ipv4_addr
		flags dynamic
		timeout 10m
	}
	# open connections per source: the relay allows 40 in all; one address gets 10
	set smtp_conns {
		type ipv4_addr
		flags dynamic
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;

		# the relay has no IPv6 identity (no AAAA, no PTR, not in the SPF): nothing arrives on it
		meta nfproto ipv6 tcp dport 25 drop
		tcp dport 25 ct state new add @smtp_meter { ip saddr limit rate over 10/minute burst 20 packets } drop
		tcp dport 25 ct state new add @smtp_conns { ip saddr ct count over 10 } drop
	}
}
